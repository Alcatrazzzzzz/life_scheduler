{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "App_Data/attachments"
    },
    "S3": {
      "Bucket": "",
      "Region": "eu-central-1"
    }
  },
  "LocalAi": {
    "Enabled": true,
    "WhisperModelPath": "models/ggml-medium.bin",
    "OnnxModelPath": "models/phi-4-mini-onnx-cpu-int4",
    "WhisperLanguage": "ru",
    "WhisperThreads": 0,
    "OnnxMaxLength": 4096,
    "MaxAudioBytes": 10485760
  }
}
